{
  "name": "md-tech-slide",
  "displayName": "md-tech-slide",
  "version": "0.1.0",
  "description": "Markdown to native PowerPoint presentation generator and previewer with flexible column layouts",
  "publisher": "ikaruga-tech",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "./dist/extension.cjs",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ikaruga-tech/md-tech-slide.git"
  },
  "homepage": "https://github.com/ikaruga-tech/md-tech-slide#readme",
  "bugs": {
    "url": "https://github.com/ikaruga-tech/md-tech-slide/issues"
  },
  "categories": [
    "Formatters",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "slide",
    "presentation",
    "powerpoint",
    "pptx",
    "pdf"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "md-tech-slide.exportPPTX",
        "title": "md-tech-slide: Export to PowerPoint (PPTX)"
      },
      {
        "command": "md-tech-slide.exportPDF",
        "title": "md-tech-slide: Export to PDF Slide"
      },
      {
        "command": "md-tech-slide.openPreview",
        "title": "md-tech-slide: Open Slide Preview",
        "shortTitle": "Open Preview",
        "icon": {
          "light": "./media/preview-light.svg",
          "dark": "./media/preview-dark.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "md-tech-slide.openPreview",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "md-tech-slide.openPreview",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@90"
        },
        {
          "command": "md-tech-slide.exportPPTX",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@100"
        },
        {
          "command": "md-tech-slide.exportPDF",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@101"
        }
      ],
      "editor/context": [
        {
          "command": "md-tech-slide.openPreview",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "1_modification@90"
        },
        {
          "command": "md-tech-slide.exportPPTX",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "1_modification@100"
        },
        {
          "command": "md-tech-slide.exportPDF",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "1_modification@101"
        }
      ]
    },
    "configuration": {
      "title": "md-tech-slide",
      "properties": {
        "mdTechSlide.defaultTheme": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "corporate",
            "dark"
          ],
          "description": "Default theme for presentation slides"
        },
        "mdTechSlide.defaultAspectRatio": {
          "type": "string",
          "default": "16:9",
          "enum": [
            "16:9",
            "4:3"
          ],
          "description": "Default aspect ratio for presentation slides"
        },
        "mdTechSlide.export.browserPath": {
          "type": "string",
          "default": "",
          "description": "Custom executable path for Google Chrome or Microsoft Edge used for PDF export"
        }
      }
    },
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets/markdown.json"
      }
    ]
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser-e2e": "vitest run --config vitest.browser-e2e.config.ts",
    "test:mermaid": "vitest run --config vitest.mermaid.config.ts",
    "test:pdf-e2e": "vitest run --config vitest.e2e.config.ts",
    "compile:prod": "node esbuild.js --production",
    "compile:test": "node scripts/prepare-extension-test.js",
    "test:extension": "npm run compile:test && tsc -p tsconfig.test.json && node generated/extension-test/runTest.js",
    "vscode:prepublish": "node esbuild.js --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "vsce package --no-dependencies",
    "package:vsix": "node scripts/package-vsix.js",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test && npm run test:browser-e2e && npm run test:mermaid && npm run test:pdf-e2e && npm run test:extension && npm run package:vsix",
    "generate:sample": "tsx scripts/generate-sample.ts",
    "generate:pdf": "tsx scripts/generate-pdf.ts",
    "generate:licenses": "node scripts/generate-licenses.js"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "markdown-it": "^14.1.0",
    "markdown-it-container": "^4.0.0",
    "mermaid": "12.1.0",
    "pptxgenjs": "^3.12.0",
    "puppeteer-core": "^24.4.0",
    "shiki": "^2.3.2",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@puppeteer/browsers": "^2.13.2",
    "@types/jszip": "^3.4.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/vscode": "^1.101.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.9.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.0.5"
  }
}
