{
  "Slide Delimiter": {
    "prefix": ["slide", "/slide"],
    "body": [
      "########",
      "",
      "## ${1:スライドタイトル}",
      "",
      "${0:スライドのコンテンツを記述}"
    ],
    "description": "新しいスライドの区切り（8連シャープ）とタイトルを挿入します"
  },
  "Two Columns": {
    "prefix": ["cols2", "/cols2", "columns2"],
    "body": [
      "::: columns",
      "::: column",
      "### ${1:左カラム}",
      "${2:左側のコンテンツ}",
      ":::",
      "::: column",
      "### ${3:右カラム}",
      "${4:右側のコンテンツ}",
      ":::",
      ":::"
    ],
    "description": "2カラムのレイアウトスロットを挿入します"
  },
  "Three Columns": {
    "prefix": ["cols3", "/cols3", "columns3"],
    "body": [
      "::: columns",
      "::: column",
      "### ${1:カラム1}",
      "${2:コンテンツ1}",
      ":::",
      "::: column",
      "### ${3:カラム2}",
      "${4:コンテンツ2}",
      ":::",
      "::: column",
      "### ${5:カラム3}",
      "${6:コンテンツ3}",
      ":::",
      ":::"
    ],
    "description": "3カラムのレイアウトスロットを挿入します"
  },
  "Ratio Columns": {
    "prefix": ["cols-ratio", "/cols-ratio"],
    "body": [
      "::: columns ratio=\"${1:2:1}\"",
      "::: column",
      "### ${2:メインカラム}",
      "${3:コンテンツ}",
      ":::",
      "::: column",
      "### ${4:サイドカラム}",
      "${5:補足情報}",
      ":::",
      ":::"
    ],
    "description": "比率指定付き（2:1等）のマルチカラムスロットを挿入します"
  },
  "Speaker Note": {
    "prefix": ["note", "/note"],
    "body": [
      "::: note",
      "${0:スピーカーノート（発表者用メモ）を記述}",
      ":::"
    ],
    "description": "PowerPointのノート領域に登録されるスピーカーノートを挿入します"
  }
}
